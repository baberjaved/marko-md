<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Marko</AssemblyName>
    <RootNamespace>Marko</RootNamespace>
    <ApplicationIcon>marko.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.2.0</Version>
    <Company>Baber Javed</Company>
    <Product>Marko</Product>
    <Description>Markdown viewer for Claude output — Reading, Plan and Interactive modes</Description>
    <Copyright>© 2026 Baber Javed. MIT License.</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <!-- viewer/ is filled by build.ps1 (viewer + vendored libraries + guide) -->
    <Content Include="viewer\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
